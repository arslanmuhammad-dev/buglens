DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/buglens
BETTER_AUTH_SECRET=local-development-only-change-this-to-a-random-32-character-secret
BETTER_AUTH_URL=http://127.0.0.1:3000
SCREENSHOT_DIR=../../storage/screenshots
# Hosted Vercel deployment only: create a PRIVATE Blob store and hosted Postgres.
# SCREENSHOT_STORAGE=vercel-blob
# BLOB_READ_WRITE_TOKEN=provided-by-vercel-never-commit
# DEMO_PASSWORD=set-a-private-password-before-seeding-a-hosted-demo

# Real local email inbox only (http://127.0.0.1:8025). Never use Mailpit on Vercel.
EMAIL_PROVIDER=mailpit
MAILPIT_URL=http://127.0.0.1:8025
# Production Gmail sender (optional, server-only). Put app password in Vercel Secret.
# EMAIL_PROVIDER=gmail
# GMAIL_USER=your-sender@gmail.com
# GMAIL_APP_PASSWORD=add-directly-in-vercel-never-commit
