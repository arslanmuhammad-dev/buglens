generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id
  name          String
  email         String          @unique
  emailVerified Boolean         @default(false)
  image         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  memberships   ProjectMember[]
  notifications Notification[]
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Project {
  id        String          @id @default(cuid())
  name      String
  key       String          @unique @default(uuid())
  origins   String[]
  ownerId   String
  owner     User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  reports   Report[]
  members   ProjectMember[]
  invites   ProjectInvite[]

  @@index([ownerId])
}

model Report {
  id                String                @id @default(cuid())
  submissionId      String?
  reporterName      String?
  reporterEmail     String?
  trackingHash      String?               @unique
  trackingExpiresAt DateTime?
  messages          ReportMessage[]
  notifications     Notification[]
  title             String
  description       String
  steps             String
  expected          String
  status            String                @default("OPEN")
  severity          String                @default("MEDIUM")
  pageUrl           String
  browser           String
  viewport          String
  projectId         String
  project           Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime              @default(now())
  events            DiagnosticEvent[]
  notes             InternalNote[]
  history           ReportStatusHistory[]
  screenshot        Screenshot?

  @@unique([projectId, submissionId])
  @@index([projectId, createdAt])
  @@index([status, severity])
}

model DiagnosticEvent {
  id       String @id @default(cuid())
  reportId String
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  order    Int
  data     Json

  @@index([reportId, order])
}

model InternalNote {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  body      String
  createdAt DateTime @default(now())
}

model ReportStatusHistory {
  id        String   @id @default(cuid())
  reportId  String
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  status    String
  createdAt DateTime @default(now())
}

model Screenshot {
  id       String @id @default(cuid())
  reportId String @unique
  report   Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  filename String
  mime     String
  bytes    Int
}

model RateLimitBucket {
  key       String   @id
  count     Int
  expiresAt DateTime
}

model RateLimit {
  id          String @id
  key         String @unique
  count       Int
  lastRequest BigInt
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([userId])
}

model ProjectInvite {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  email     String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([projectId])
}

model ReportMessage {
  id         String   @id @default(cuid())
  reportId   String
  report     Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  clientId   String
  authorRole String
  authorName String
  body       String
  createdAt  DateTime @default(now())

  @@unique([reportId, clientId])
  @@index([reportId, createdAt, id])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String
  report    Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  kind      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}
